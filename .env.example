# ==============================================================================
# DOANHNHANHOLE.TODAY - ENVIRONMENT CONFIGURATION
# Sao chép file này thành .env và điền các giá trị phù hợp với môi trường VPS của bạn.
# ==============================================================================

# Cấu hình Server (VPS Port 3034)
PORT=3034
NODE_ENV=production
SITE_URL=https://doanhnhanhole.today
DEMO_SITE_URL=https://dev.doanhnhanhole.today
JWT_SECRET=doanhnhanhole_today_super_secret_jwt_key_2026_please_change

# Cấu hình Thương hiệu (Brand Identity)
APP_NAME=Doanhnhanhole.today Platform
BRAND_NAME=Doanhnhanhole.today
BRAND_SHORT_NAME=Doanh nhân Họ Lê
AI_AGENT_NAME=AI Doanh Nhân Họ Lê
SUPPORT_EMAIL=banthuky@doanhnhanhole.today

# Cấu hình Cơ sở dữ liệu MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=doanhnhanhole_today_db

# Cấu hình Trí tuệ Nhân tạo Google Gemini (AI Chat & RAG)
GEMINI_API_KEY=your_gemini_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Cấu hình Gửi Email SMTP (Xác thực, Vé sự kiện, Thông báo duyệt)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM_NAME=Ban Thư Ký Doanhnhanhole.today
SMTP_FROM="Doanhnhanhole.today" <banthuky@doanhnhanhole.today>
